---
import FooterAnnouncementEntry from '@components/announcement/FooterAnnouncementEntry';
import { MAX_WIDTH } from '@constants/layout';
import { icpConfig, policeConfig, siteConfig, umamiSiteStatsConfig } from '@constants/site-config';
import { getSiteStats } from '@lib/stats';
import { cn } from '@lib/utils';
import { Icon } from 'astro-icon/components';
import UmamiPVSpan from '@/components/umami/UmamiPVSpan';
import { getLocaleFromUrl, t } from '@/i18n';
import SakuraSVG from '../svg/SakuraSvg';

interface Props {
  className?: string;
}

const { className } = Astro.props;

const locale = getLocaleFromUrl(Astro.url.pathname);
const stats = await getSiteStats();
const currentYear = new Date().getFullYear();
const startYear = siteConfig?.startYear ?? currentYear;
---

{/* 独立合成层，减轻切页 View Transition / 多层 opacity 造成的文字叠影 */}
<footer class={cn('site-footer mt-auto pb-6', className)}>
  <div class={cn('mx-auto flex flex-col items-center gap-3 px-6 md:pb-10 md:px-3', MAX_WIDTH.content)}>
    <!-- Announcements Entry -->
    <FooterAnnouncementEntry client:idle />

    <!-- Site Stats -->
    <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-6 text-sm md:gap-4">
      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.totalWordsTitle')}>
        <Icon name="ri:file-text-line" class="h-4 w-4" />
        <span class="font-medium">{stats.formattedWords}</span>
        <span class="text-xs">{t(locale, 'footer.wordUnit')}</span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.readingTimeTitle')}>
        <Icon name="ri:time-line" class="h-4 w-4" />
        <span class="font-medium">{stats.formattedTime}</span>
      </button>

      <div class="bg-muted-foreground/30 h-4 w-px"></div>

      <button class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'footer.postCountTitle')}>
        <Icon name="ri:article-line" class="h-4 w-4" />
        <span class="font-medium">{stats.postCount}</span>
        <span class="text-xs">{t(locale, 'footer.postUnit')}</span>
      </button>

      {umamiSiteStatsConfig && (
        <>
          <div class="bg-muted-foreground/30 h-4 w-px"></div>
          <div class="flex items-center gap-2 opacity-75 transition-opacity duration-300 hover:opacity-100" title={t(locale, 'stats.pageviews')}>
            <Icon name="ri:eye-line" class="h-4 w-4" />
            <span class="font-medium"><UmamiPVSpan client:visible statsConfig={umamiSiteStatsConfig} /></span>
            <span class="text-xs">{t(locale, 'stats.pageviews')}</span>
          </div>
        </>
      )}

    </div>

    <!-- 英文正式版权 + 备案 + 主题致谢 -->
    <div class="site-footer__meta text-muted-foreground flex max-w-3xl flex-col items-center gap-2.5 text-center text-xs leading-relaxed sm:text-sm">
      <p class="site-footer__line flex flex-wrap items-center justify-center gap-x-1" itemprop="copyrightHolder">
        <span>©</span>
        <span class="font-medium">{startYear}{startYear !== currentYear ? `-${currentYear}` : ''}</span>
        <SakuraSVG className="mx-0.5 size-4 animate-spin text-[#9ec8ef] duration-10000" />
        <span class="font-medium">{siteConfig.name}</span>
        <span>. All rights reserved.</span>
      </p>

      {(icpConfig || policeConfig) && (
        <p class="site-footer__line text-muted-foreground/80 flex flex-col items-center gap-y-1 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-2">
          {icpConfig && (
            icpConfig.link ? (
              <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link font-medium">
                {icpConfig.text}
              </a>
            ) : (
              <span>{icpConfig.text}</span>
            )
          )}
          {icpConfig && policeConfig && <span class="hidden opacity-40 sm:inline" aria-hidden="true">|</span>}
          {policeConfig && (
            policeConfig.link ? (
              <a
                href={policeConfig.link}
                target="_blank"
                rel="noopener noreferrer"
                class="footer-link inline-flex items-center gap-1 font-medium"
              >
                {policeConfig.icon && (
                  <img src={policeConfig.icon} alt="" width="14" height="14" class="inline-block" />
                )}
                {policeConfig.text}
              </a>
            ) : (
              <span class="inline-flex items-center gap-1">
                {policeConfig.icon && (
                  <img src={policeConfig.icon} alt="" width="14" height="14" class="inline-block" />
                )}
                {policeConfig.text}
              </span>
            )
          )}
        </p>
      )}

      <p class="site-footer__line text-muted-foreground/70 flex flex-wrap items-center justify-center gap-x-1.5">
        <span>Powered by</span>
        <a
          href="https://github.com/cosZone/astro-koharu"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link font-medium"
        >
          astro-koharu
        </a>
        <span class="opacity-40" aria-hidden="true">·</span>
        <span>Inspired by</span>
        <a
          href="https://github.com/amehime/hexo-theme-shoka"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link font-medium"
        >
          Shoka
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* 不参与根快照变形；独立合成层，避免旧页脚文字叠到新行上 */
  .site-footer {
    view-transition-name: none;
    isolation: isolate;
  }

  .site-footer__meta {
    isolation: isolate;
  }

  .site-footer__line {
    position: relative;
    z-index: 0;
    opacity: 0.8;
  }

  .footer-link {
    opacity: 0.75;
    position: relative;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }
</style>
