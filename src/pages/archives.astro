---
import PageIntro from '@components/common/PageIntro.astro';
import PostYears from '@components/common/PostYears.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { Layout, TwoColumnLayout } from '@layouts/index';
import { siteConfig, siteTimezone } from '@lib/config/site';
import { getSortedPosts } from '@lib/content';
import { colophonMarkIds } from '@lib/content/colophon';
import { colophonFilterChips } from '@lib/content/colophon-view';
import { bucketPostsByDay, buildYearHeatmap, dailyPeak } from '@lib/content/heatmap';
import { groupPostsByYear } from '@lib/content/index-groups';
import { getColophonConfig, getPostColophon } from '@lib/content/post-colophon';
import { Icon } from 'astro-icon/components';
import { formatInTimeZone } from 'date-fns-tz';
import type { BlogPost } from 'types/blog';
import { defaultLocale, t } from '@/i18n';

interface Props {
  locale?: string;
}
const { locale = defaultLocale } = Astro.props;
const posts = await getSortedPosts(locale);
const years = groupPostsByYear(posts, siteTimezone);
const dayCounts = bucketPostsByDay(posts, siteTimezone);
const peak = dailyPeak(dayCounts);
const todayKey = formatInTimeZone(new Date(), siteTimezone, 'yyyy-MM-dd');
const heatmaps = years.map(({ year }) => buildYearHeatmap(year, dayCounts, todayKey, peak));
const range = years.length ? `${years.at(-1)?.year}–${years[0].year}` : '—';
const stats = [
  { value: posts.length, label: t(locale, 'index.posts') },
  { value: range, label: t(locale, 'index.years') },
];
const markIds = new Map<BlogPost, string[]>(posts.map((post) => [post, colophonMarkIds(getPostColophon(post, locale))]));
const markChips = colophonFilterChips(getColophonConfig(locale).marks, [...markIds.values()]);
const marksOf = markChips.length ? (post: BlogPost) => markIds.get(post) ?? [] : undefined;
// GitHub 式：只标出一 / 三 / 五（或对应语言缩写）
const weekdayLabels = [
  t(locale, 'archives.weekdayMon'),
  '',
  t(locale, 'archives.weekdayWed'),
  '',
  t(locale, 'archives.weekdayFri'),
  '',
  '',
];
---
<Layout articleTools={false} locale={locale} title={`${t(locale, 'archives.title')} | ${siteConfig.title}`} description={t(locale, 'archives.title')}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover compact slot="cover" title={t(locale, 'archives.title')} />
    <HomeSider slot="sider" />
    <div class="index-surface shadow-box" data-archive data-colophon-filter-root>
      <PageIntro stats={stats}>
        {markChips.length > 0 && <div class="index-tabs index-tabs-quiet colophon-filter" slot="tools" role="group" aria-label={t(locale, 'colophon.filter')}>
          <button type="button" data-colophon-filter="" aria-pressed="true">{t(locale, 'tag.all')}<sup>{posts.length}</sup></button>
          {markChips.map((chip) => <button type="button" data-colophon-filter={chip.id} aria-pressed="false"><Icon name={chip.icon} aria-hidden="true" />{chip.label}<sup>{chip.count}</sup></button>)}
        </div>}
      </PageIntro>
      {heatmaps.length > 0 && <section class="archive-calendar" aria-labelledby="calendar-title">
        <div class="archive-calendar-head">
          <h2 id="calendar-title">{t(locale, 'archives.calendar')}</h2>
          <div class="archive-calendar-legend" aria-hidden="true">
            {t(locale, 'archives.legendFew')}
            {[0, 1, 2, 3, 4].map((tier) => <span class="archive-day-cell" data-tier={tier}></span>)}
            {t(locale, 'archives.legendMany')}
          </div>
        </div>
        {heatmaps.map((heat) => (
          <div class="archive-heatmap" data-year={heat.year}>
            <a class="archive-heatmap-year" href={`#year-${heat.year}`} aria-label={t(locale, 'archives.jumpToYear', { year: heat.year })}>{heat.year}</a>
            <div class="archive-heatmap-scroll">
              <div class="archive-heatmap-board" style={`--heat-weeks: ${heat.weeks.length}`}>
                <div class="archive-heatmap-weekdays" aria-hidden="true">
                  {weekdayLabels.map((label) => <span>{label}</span>)}
                </div>
                <div class="archive-heatmap-months" aria-hidden="true">
                  {heat.monthLabels.map(({ month, weekIndex }) => (
                    <span style={`grid-column: ${weekIndex + 1}`}>{month}</span>
                  ))}
                </div>
                <div class="archive-heatmap-weeks">
                  {heat.weeks.map((week) => (
                    <div class="archive-heatmap-week">
                      {week.days.map((day) => {
                        if (day.outside) return <span class="archive-day-cell" data-tier="outside"></span>;
                        const label = t(locale, 'archives.dayLabel', {
                          year: day.year,
                          month: day.month,
                          day: day.day,
                          count: day.count,
                        });
                        if (day.count > 0) {
                          const monthKey = day.key.slice(0, 7);
                          return (
                            <a
                              class="archive-day-cell"
                              data-tier={day.tier}
                              href={`#month-${monthKey}`}
                              title={label}
                              aria-label={label}
                            ></a>
                          );
                        }
                        return (
                          <span
                            class="archive-day-cell"
                            data-tier={day.future ? 'future' : '0'}
                            title={day.future ? undefined : label}
                          ></span>
                        );
                      })}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </section>}
      <PostYears posts={posts} locale={locale} anchors marksOf={marksOf} />
    </div>
  </TwoColumnLayout>
</Layout>
<script>
  import { setupArchiveNavigation } from '@lib/archive-navigation';
  import { setupColophonFilter } from '@lib/colophon-filter';
  setupArchiveNavigation();
  setupColophonFilter();
</script>
